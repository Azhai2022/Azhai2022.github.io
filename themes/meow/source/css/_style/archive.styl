.page-container
  width: 85%
  margin: 0 auto

  a
    text-decoration: none
    color: text-black

.page-title
  color: orange-middle

  h1
    margin: 0.5em 0

  i
    margin-right: 5px

  a
    color: inherit
    text-decoration: none

.archives-year
  margin: 20px 0

.archives-year-link
  font-size: article-title1-font-size
  font-weight: bold
  display: block
  width: 100%
  padding: 5px 0
  border-bottom: 2px solid border-grey
  vertical-align: middle



.archives-month
  margin: 4px 0

.archives-month-link
  margin: 2px 0
  display: block
  font-size: article-title3-font-size
  font-weight: bold
  color: orange-middle !important
  border-top: 1px solid border-grey
  padding-top: 4px

  i
    margin-right: 6px
    display: inline-block
    vertical-align: middle

  .month-text
    position: relative
    top: 1px


//- remove duplicate line right after year
.archives-year > .archives-month:first-of-type .archives-month-link
  border-top: none
  padding-top: 0
.archives-article-list
  display: flex
  flex-flow: column nowrap
  align-items: flex-start

.article-item
  width: 100%
  margin-right: 0
  margin-top: 4px

.article-item-card
  display: flex
  flex-flow: row nowrap
  width: 100%
  font-size: info-font-size-normal
  padding: 2px 0


.article-item-title
  font-size: default-font-size
  font-weight: bold
  margin: 0

.article-item-preview
  margin: 0 10px 10px
  word-break: break-all
  overflow: hidden
  text-align: justify

.article-item-hover
  display: none

@media screen and (max-width: 820px)
  .article-item-title
    margin: 5px 0


.page-tag-name
  display: inline-block
  margin-top: 6px
  font-size: article-title4-font-size
