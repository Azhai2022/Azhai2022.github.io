.blog-info
  margin: 20px auto
  display: flex
  align-items: center
  flex-flow: column nowrap
  max-width: max-page-width
  width: 90%

#blog-pic
  width: 180px
  height: 180px
  margin: 0
  
.blog-title
  font-size: 40px
  font-weight: bold
  color: #ffffff
  text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.125)
  white-space: nowrap
  overflow: hidden
  animation: title-run 0.8s ease-in-out linear
  -webkit-animation: title-run 0.8s linear

  span
    margin: 0 15px
    font-weight: 1200
  
  i
    --fa-rotate-angle: 45deg

    &:first-child
      --fa-rotate-angle: 315deg

.blog-desc
  font-size: default-font-size
  color: white
  text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.125)
  text-align: center
  margin: 20px auto

.blog-marquee
  width: 100%
  max-width: max-page-width
  overflow: hidden
  margin: 0 auto 10px
  text-align: center

.blog-marquee-track
  display: inline-block
  white-space: nowrap
  padding-left: 100%
  animation: blog-marquee 14s linear infinite
  color: #d93025
  font-weight: 700
  text-shadow: none

  span
    display: inline-block
    padding: 0 10px

@keyframes blog-marquee
  0%
    transform: translateX(0)
  100%
    transform: translateX(-100%)

.sidebar-panels
  width: 100%
  max-width: max-page-width
  margin-top: 10px

.sidebar-random
  width: 100%
  max-width: max-page-width
  margin-top: 10px

  .random-header
    display: flex
    align-items: center
    gap: 6px
    padding: 8px 12px
    color: #4a9eed
    font-size: 14px
    border: 1px solid rgba(255, 255, 255, 0.2)
    border-radius: 8px
    cursor: pointer
    transition: background 0.2s

    &:hover
      background rgba(255, 255, 255, 0.1)

    .random-arrow
      margin-left: auto
      font-size: 12px
      transition: transform 0.2s

  .random-header.open .random-arrow
    transform: rotate(180deg)

  .random-menu
    max-height: 0
    overflow: hidden
    transition: max-height 0.3s ease
    background rgba(0, 0, 0, 0.15)
    border-radius: 0 0 8px 8px

    &.open
      max-height: 100px

    .random-option
      padding: 8px 12px
      color: #4a9eed
      font-size: 13px
      cursor: pointer
      transition: background 0.2s

      &:hover
        background rgba(255, 255, 255, 0.08)

.sidebar-panel
  border: 1px solid rgba(255, 255, 255, 0.2)
  border-radius: 8px
  margin-bottom: 8px
  overflow: hidden

  .panel-header
    display: flex
    align-items: center
    gap: 6px
    padding: 8px 12px
    cursor: pointer
    color: #4a9eed
    font-size: 14px
    user-select: none
    transition: background 0.2s

    &:hover
      background rgba(255, 255, 255, 0.1)

    .panel-arrow
      margin-left: auto
      transition: transform 0.2s
      font-size: 12px

  &.open .panel-arrow
    transform: rotate(180deg)

  .favorite-list
    max-height: 0
    overflow: hidden
    transition: max-height 0.3s ease
    background rgba(0, 0, 0, 0.15)

  &.open .favorite-list
    max-height: 300px
    overflow-y: auto

  #last-read-list
    max-height: 0
    overflow: hidden
    transition: max-height 0.3s ease
    background rgba(0, 0, 0, 0.15)

  &.open #last-read-list
    max-height: 100px

  .newsletter-panel-content
    max-height: 0
    overflow: hidden
    padding: 0 12px
    background rgba(0, 0, 0, 0.15)
    transition: max-height 0.3s ease, padding 0.3s ease

  &.open .newsletter-panel-content
    max-height: 260px
    padding: 0 12px 12px

  .newsletter-panel-content > p
    margin: 3px 0 8px
    color: rgba(255, 255, 255, 0.8)
    font-size: 14px

  .newsletter-toggle
    appearance: none
    width: 100%
    border: 0
    background: transparent
    font: inherit
    font-size: 14px
    text-align: left

.announcement-panel
  .panel-header
    cursor: default
    color: #68c174

    &:hover
      background: transparent

  .announcement-content
    background: transparent

  .announcement-empty
    flex: 1
    color: #68c174
    font-size: 13px

  .announcement-first
    flex: 1
    color: #68c174
    font-size: 13px

  .announcement-list
    display: none
    margin: 0
    padding: 0 12px 10px 34px
    color: #68c174
    font-size: 13px

    li
      padding: 3px 0

  &.has-announcements
    .announcement-empty
      display: none

    .announcement-first
      display: inline

  &.has-followups
    .announcement-list
      display: block

.sidebar-panel .empty-msg
  padding: 8px 12px
  text-align: center
  color: rgba(255, 255, 255, 0.5)
  font-size: 13px

.sidebar-panel .list-item
  display: flex
  align-items: center
  padding: 8px 12px
  color: #4a9eed
  text-decoration none
  font-size: 13px
  border-bottom 1px solid rgba(255, 255, 255, 0.08)
  transition: background 0.2s

  &:hover
    background rgba(255, 255, 255, 0.08)

  .item-title
    flex 1
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  .item-percent
    margin-left 8px
    font-size 11px
    color rgba(255, 255, 255, 0.5)

  .item-remove
    background none
    border none
    color: #4a9eed
    font-size 16px
    cursor pointer
    padding 0 4px
    margin-left 6px
    transition: color 0.2s

    &:hover
      color #ff6b6b
