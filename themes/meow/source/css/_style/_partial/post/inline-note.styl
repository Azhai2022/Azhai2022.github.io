.inline-note-ref
  cursor: pointer
  display: inline-block
  font-size: 0.7em
  width: 1.2em
  height: 1.2em
  line-height: 1.2em
  text-align: center
  vertical-align: super
  margin-left: 2px
  border-radius: 999px
  background: orange-middle
  color: #fff

.inline-note-popup
  position: absolute
  z-index: 9999
  max-width: 260px
  padding: 6px 8px
  background: #fffbe6
  border: 1px solid #f1c40f
  border-radius: 6px
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12)
  font-size: 12px
  line-height: 1.4
  color: #333
  display: none
