.newsletter-panel-content
  font-size: 14px

  label
    display: block
    margin-bottom: 5px
    color: white
    font-size: 14px

.newsletter-fields
  display: flex
  gap: 8px

  input
    box-sizing: border-box
    flex: 1
    min-width: 0
    width: 100%
    max-width: 100%
    height: 38px
    padding: 0 10px
    border: 1px solid rgba(180, 120, 64, 0.45)
    border-radius: 4px
    background: white
    color: #292522
    font: inherit

  button
    flex: 0 0 auto
    min-height: 38px
    padding: 0 12px
    border: 0
    border-radius: 4px
    background: orange-normal
    color: white
    font: inherit
    cursor: pointer

    &:disabled
      cursor: wait
      opacity: 0.65

.newsletter-status
  min-height: 1.5em
  margin: 8px 0 0 !important
  font-size: 14px

  &[data-state='error']
    color: #a52a2a

  &[data-state='success']
    color: #39734a

.newsletter-panel-content .newsletter-status
  margin-bottom: 0 !important

.newsletter-honeypot
  position: absolute
  width: 1px
  height: 1px
  overflow: hidden
  clip: rect(0, 0, 0, 0)
  white-space: nowrap

@media (max-width: 420px)
  .newsletter-fields
    flex-direction: column
