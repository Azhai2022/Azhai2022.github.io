.pagination
  margin: 30px auto 5px
  display: flex
  flex-wrap: wrap
  align-items: center
  justify-content: center
  font-size: pagination-font-size

  a
    color: text-black-light
    text-decoration: none

    &:hover
      color: orange-fresh

  .prev, .next
    color: text-black-light

    &:hover
      color: orange-fresh

    i
      color: border-grey
      margin: 0 10px

      &:hover
        color: orange-fresh

  .page-number
    margin: 0 5px

  .current
    border: 1px solid border-grey
    border-radius: 10px
    padding: 0.5px 10px

  .page-jump
    width: 100%
    margin-top: 10px
    display: flex
    align-items: center
    justify-content: center
    gap: 5px
    font-size: info-font-size

    #page-jump-input
      width: 45px
      padding: 3px 5px
      border: 1px solid border-grey
      border-radius: 5px
      text-align: center
      font-size: info-font-size
      outline: none

      &:focus
        border-color: orange-fresh

    #page-jump-btn
      padding: 3px 8px
      border: 1px solid border-grey
      border-radius: 5px
      background-color: transparent
      cursor: pointer
      font-size: info-font-size
      color: text-black-light

      &:hover
        border-color: orange-fresh
        color: orange-fresh
