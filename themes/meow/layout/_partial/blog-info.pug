.blog-info
  //- display site icon 展示博客图标
  .blog-pic
    img#blog-pic(src= url_for(theme.blog_pic))

  //- blog's title 博客标题
  .blog-title
    i.fa-solid.fa-paw.fa-2xs.fa-rotate-by
    span= __('blog_info.title')
    i.fa-solid.fa-paw.fa-2xs.fa-rotate-by

  //- blog's description 博客介绍
  .blog-desc
    | !{ __('blog_info.description') }

  .blog-marquee
    .blog-marquee-track
      span 禁止传播此站网址，截图时请勿带网址

  .sidebar-random
    .random-header( onclick= "toggleRandomMenu()" )
      i.fa-solid.fa-shuffle
      span 随机看一篇
      i.fa-solid.fa-chevron-down.random-arrow
    .random-menu
      .random-option( onclick= "randomPost('原著向')" ) 原著向
      .random-option( onclick= "randomPost('AU')" ) AU

  .sidebar-panels
    .sidebar-panel
      .panel-header
        i.fa-solid.fa-heart
        span 收藏
        i.fa-solid.fa-chevron-down.panel-arrow
      .favorite-list
        .empty-msg 暂无收藏

    .sidebar-panel
      .panel-header
        i.fa-solid.fa-clock-rotate-left
        span 上次读到
        i.fa-solid.fa-chevron-down.panel-arrow
      .last-read-list(id="last-read-list")
        .empty-msg 暂无记录

    if theme.newsletter && theme.newsletter.enable
      .sidebar-panel.newsletter-panel
        button.panel-header.newsletter-toggle(
          type="button"
          aria-expanded="false"
          aria-controls="newsletter-panel-content"
        )
          i.fa-regular.fa-envelope
          span 订阅本站
          i.fa-solid.fa-chevron-down.panel-arrow
        .newsletter-panel-content(id="newsletter-panel-content")
          p 新文章与章节更新会通过邮件通知你。
          form#newsletter-form(
            action="#"
            data-api=theme.newsletter.server_url
          )
            label(for="newsletter-email") 邮箱地址
            .newsletter-fields
              input#newsletter-email(
                type="email"
                name="email"
                autocomplete="email"
                maxlength="254"
                placeholder="name@example.com"
                required
              )
              button(type="submit") 订阅
            .newsletter-honeypot(aria-hidden="true")
              label(for="newsletter-website") Leave this field empty
              input#newsletter-website(
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
              )
            p#newsletter-status.newsletter-status(role="status" aria-live="polite")

    .sidebar-panel.announcement-panel
      .panel-header(data-static-panel="true")
        i.fa-solid.fa-bullhorn
        span 公告：
        span.announcement-empty 一切功能正常，发现问题请告知斋解决
        span.announcement-first
      .announcement-content
        ol.announcement-list
          li 订阅功能已恢复，输入邮箱即可订阅本站
          li 若遇其他功能失效问题，告知斋解决
