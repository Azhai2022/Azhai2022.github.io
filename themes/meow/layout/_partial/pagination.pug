.pagination
  - const paginationHtml = paginator({prev_text: '<i class="icon-prev fa-solid fa-chevron-left"></i>', next_text: '<i class="icon-next fa-solid fa-chevron-right"></i>', escape: false, mid_size: 1, force_prev_next: true}).replace(/&amp;hellip;|&hellip;/g, '…')
  | !{ paginationHtml }
  .page-jump
    span 跳至
    input#page-jump-input(type='number' min='1' max= page.total placeholder= page.current)
    span 页
    button#page-jump-btn(onclick='jumpToPage()') GO
