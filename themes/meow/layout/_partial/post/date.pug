.post-date
  if is_home()
    if post.update_date
      i.icon.fa-regular.fa-calendar-check(title= __('datetime.updated'))
      time.publish-time= '更新于：' + date(post.update_date)
    else
      i.icon.fa-regular.fa-calendar-plus(title= __('datetime.published'))
      time.publish-time= date(post.date)
  else
    //- post's published date(formatted by config.date_format) 文章发表日期(显示格式由config.date_format配置)
    i.icon.fa-regular.fa-calendar-plus(title= __('datetime.published'))
    time.publish-time= date(post.date)

    //- post's updated date 文章更新日期
    i.icon.fa-regular.fa-calendar-check(title= __('datetime.updated'))
    time.update-time= date(post.updated)
